<!DOCTYPE html>
<html lang="ar" dir="rtl" data-theme="black">

<%- include("./partials/header.ejs", { pageTitle: 'أمان الجلسات' }) %>

<body class="min-h-screen bg-black pb-24 md:pb-10 md:pt-15">
     <%- include("./partials/navbar.ejs") %>

     <div class="max-w-2xl mx-auto px-4 pt-6">
          <h1 class="text-xl font-bold text-white mb-6">أمان الجلسات — القائمة السوداء</h1>

          <% if (typeof error !== 'undefined' && error) { %>
               <div class="alert alert-soft alert-error text-sm mb-6"><%= error %></div>
          <% } %>

          <div class="card bg-blur border border-neutral-600 mb-6">
               <div class="card-body gap-4">
                    <p class="text-white font-medium">حظر عنوان IP أو جهاز</p>
                    <form method="POST" action="/admin/security/block" class="flex flex-col gap-3">
                         <div>
                              <label class="label-text" for="blockType">النوع</label>
                              <select name="type" id="blockType" required class="select w-full">
                                   <option value="ip">عنوان IP</option>
                                   <option value="device">جهاز</option>
                              </select>
                         </div>
                         <input type="text" name="value" placeholder="القيمة المطلوب حظرها" required class="input">
                         <input type="text" name="reason" placeholder="السبب (اختياري)" class="input">
                         <button type="submit" class="btn btn-primary">
                              حظر
                              <i class="fi fi-sr-ban text-sm"></i>
                         </button>
                    </form>
               </div>
          </div>

          <p class="text-white font-medium mb-3">قائمة الحظر الحالية</p>

          <% if (!blocks || blocks.length === 0) { %>
               <p class="text-center text-white/50 py-10">لا توجد أي عناوين أو أجهزة محظورة حالياً.</p>
          <% } else { %>
               <div class="flex flex-col gap-3">
                    <% blocks.forEach(block => { %>
                         <div class="card bg-blur border border-neutral-600">
                              <div class="card-body p-4 flex-row items-center justify-between gap-3">
                                   <div>
                                        <div class="flex items-center gap-2">
                                             <span class="badge badge-soft <%= block.type === 'ip' ? 'badge-primary' : 'badge-neutral' %> text-xs">
                                                  <%= block.type === 'ip' ? 'IP' : 'جهاز' %>
                                             </span>
                                             <span class="text-white font-mono text-sm"><%= block.value %></span>
                                        </div>
                                        <% if (block.reason) { %>
                                             <p class="text-white/50 text-xs mt-1"><%= block.reason %></p>
                                        <% } %>
                                        <p class="text-white/30 text-xs mt-1"><%= new Date(block.createdAt).toLocaleString('ar-EG') %></p>
                                   </div>
                                   <form method="POST" action="/admin/security/unblock/<%= block._id %>">
                                        <button type="submit" class="btn btn-soft btn-error btn-sm">
                                             إلغاء الحظر
                                             <i class="fi fi-sr-cross text-xs"></i>
                                        </button>
                                   </form>
                              </div>
                         </div>
                    <% }) %>
               </div>
          <% } %>
     </div>
</body>
</html>
