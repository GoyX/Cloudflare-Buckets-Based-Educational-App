<!DOCTYPE html>
<html lang="ar" dir="rtl" data-theme="black">

<%- include("./partials/header.ejs", { pageTitle: 'إدارة الدورات' }) %>

<body class="min-h-screen bg-black pb-24 md:pb-10 md:pt-15">
     <%- include("./partials/navbar.ejs") %>

     <div class="max-w-5xl mx-auto px-4 pt-6">
          <div class="flex items-center justify-between mb-6">
               <h1 class="text-xl font-bold text-white">إدارة الدورات</h1>
               <a href="/admin/add-course" class="btn btn-primary btn-sm">
                    إضافة دورة
                    <i class="fi fi-sr-plus text-xs"></i>
               </a>
          </div>

          <% if (!courses || courses.length === 0) { %>
               <div class="text-center py-16 text-white/50">
                    لا توجد دورات بعد. <a href="/admin/add-course" class="link link-primary no-underline">أضف دورة</a>
               </div>
          <% } else { %>
               <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
                    <% courses.forEach(course => { %>
                    <div class="card bg-blur border border-neutral-600 overflow-hidden">
                         <figure class="h-32 bg-cover bg-center" style="background-image:url('/uploads/<%= course.thumbnail %>');"></figure>
                         <div class="card-body p-4 gap-1">
                              <p class="text-white font-medium leading-snug"><%= course.title %></p>
                              <div class="flex items-center justify-between text-sm text-white/50">
                                   <span><%= course.students %> طالب</span>
                                   <span class="text-primary font-medium">$<%= course.price %></span>
                              </div>
                              <a href="/manage/<%= course._id %>" class="btn btn-soft btn-primary btn-sm w-full mt-2">
                                   إدارة
                                   <i class="fi fi-sr-settings text-xs"></i>
                              </a>
                         </div>
                    </div>
                    <% }) %>
               </div>
          <% } %>
     </div>
</body>
</html>
