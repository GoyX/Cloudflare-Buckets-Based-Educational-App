<!DOCTYPE html>
<html lang="ar" dir="rtl" data-theme="black">

<%- include("./partials/header.ejs", { pageTitle: course.title }) %>

<body class="min-h-screen bg-black pb-24 md:pb-10 md:pt-15">
     <%- include("./partials/navbar.ejs") %>

     <div class="max-w-3xl mx-auto px-4 pt-6">
          <div class="card bg-blur border border-neutral-600 overflow-hidden">
               <figure class="h-52 md:h-72 bg-cover bg-center" style="background-image:url('/uploads/<%= course.thumbnail %>');"></figure>

               <div class="card-body gap-5">
                    <h1 class="text-2xl font-bold text-white"><%= course.title %></h1>

                    <ul class="flex flex-wrap gap-x-6 gap-y-3 text-sm text-white/70">
                         <li class="flex items-center gap-1.5"><i class="fi fi-sr-users text-primary"></i> <%= course.students %> طالب</li>
                         <li class="flex items-center gap-1.5"><i class="fi fi-sr-language text-primary"></i> <%= course.lang %></li>
                         <li class="flex items-center gap-1.5"><i class="fi fi-sr-clock-three text-primary"></i> <%= course.hours %> ساعة للمشاهدة</li>
                         <li class="flex items-center gap-1.5"><i class="fi fi-sr-chalkboard-user text-primary"></i> <%= course.lecturesNumber %> محاضرة</li>
                    </ul>

                    <div class="flex flex-col items-stretch gap-2">
                         <% if (userOwns) { %>
                              <a class="btn btn-primary w-full" href="/watch/<%= course._id %>">
                                   مشاهدة الدورة
                                   <i class="fi fi-sr-play text-sm"></i>
                              </a>
                              <p class="text-center text-sm text-success">أنت مسجّل في هذه الدورة</p>
                         <% } else { %>
                              <a class="btn btn-primary w-full" href="/payment/<%= course._id %>">
                                   الشراء ($<%= course.price %>)
                                   <i class="fi fi-sr-shopping-cart text-sm"></i>
                              </a>
                              <p class="text-center text-xs text-white/40">بشرائك أنت توافق على جميع الشروط التي توفرها المنصة</p>
                         <% } %>
                    </div>

                    <div class="border-t border-neutral-600"></div>

                    <div>
                         <p class="text-white/70 leading-relaxed"><%= course.description %></p>
                    </div>

                    <% if (course.learnPoint && course.learnPoint.length > 0) { %>
                    <div>
                         <p class="text-white font-medium mb-3">ما الذي تقدمه الدورة</p>
                         <ul class="grid sm:grid-cols-2 gap-x-4 gap-y-2">
                              <% course.learnPoint.forEach(point => { %>
                                   <li class="flex items-start gap-2 text-sm text-white/70">
                                        <i class="fi fi-sr-check-circle text-primary mt-0.5"></i>
                                        <span><%= point %></span>
                                   </li>
                              <% }) %>
                         </ul>
                    </div>
                    <% } %>
               </div>
          </div>
     </div>
     <br><br><br><br><br>
</body>
</html>
