<!DOCTYPE html>
<html lang="ar" dir="rtl" data-theme="black">

<%- include("./partials/header.ejs", { pageTitle: 'إنشاء حساب' }) %>

<body class="min-h-screen bg-black">
     <%- include("./partials/loader.ejs") %>
     <%- include("./partials/navbar.ejs") %>

     <div class="min-h-screen flex items-center justify-center px-4 pb-24 pt-10 md:pt-24 md:pb-10">
          <div class="w-full max-w-md">
               <div class="card bg-blur border border-neutral-600 shadow-xl">
                    <div class="card-body gap-5">
                         <div class="text-center">
                              <h1 class="text-xl font-bold text-white">إنشاء حساب جديد</h1>
                              <div class="w-16 border-b radial-border mx-auto mt-3"></div>
                         </div>

                         <% if (typeof errors !== 'undefined' && errors) { %>
                              <div class="alert alert-soft alert-error text-sm" role="alert">
                                   <ul class="list-disc ps-4">
                                        <% errors.forEach(e => { %><li><%= e.msg %></li><% }) %>
                                   </ul>
                              </div>
                         <% } %>
                         <% if (typeof error !== 'undefined' && error) { %>
                              <div class="alert alert-soft alert-error text-sm" role="alert"><%= error %></div>
                         <% } %>
                         <% if (typeof note !== 'undefined' && note) { %>
                              <div class="alert alert-soft alert-success text-sm" role="alert"><%= note %></div>
                         <% } %>

                         <form method="POST" action="/signup" class="flex flex-col gap-4">
                              <div class="input-floating">
                                   <input type="text" name="userName" id="signupName" placeholder="اسم المستخدم"
                                          class="input" required minlength="3" maxlength="30" autocomplete="name">
                                   <label class="input-floating-label" for="signupName">اسم المستخدم</label>
                              </div>

                              <div class="input-floating">
                                   <input type="email" name="email" id="signupEmail" placeholder="user@example.com"
                                          class="input" required autocomplete="email">
                                   <label class="input-floating-label" for="signupEmail">البريد الإلكتروني</label>
                              </div>

                              <div class="input-floating">
                                   <input type="password" name="password" id="signupPassword" placeholder="••••••••"
                                          class="input" required minlength="8" maxlength="128" autocomplete="new-password">
                                   <label class="input-floating-label" for="signupPassword">كلمة المرور</label>
                              </div>

                              <button type="submit" class="btn btn-primary w-full mt-1">
                                   تسجيل
                                   <i class="fi fi-sr-user-add text-sm"></i>
                              </button>
                         </form>

                         <p class="text-center text-sm text-white/60">
                              لديك حساب بالفعل؟
                              <a href="/login" class="link link-primary no-underline font-medium">تسجيل الدخول</a>
                         </p>
                    </div>
               </div>
          </div>
     </div>
</body>
</html>
