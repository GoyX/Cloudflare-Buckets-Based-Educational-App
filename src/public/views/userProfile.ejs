<!DOCTYPE html>
<html lang="ar" dir="rtl" data-theme="black">

<%- include("./partials/header.ejs", { pageTitle: 'الملف الشخصي' }) %>

<body class="min-h-screen bg-black pb-24 md:pb-10 md:pt-15">
     <%- include("./partials/loader.ejs") %>
     <%- include("./partials/navbar.ejs") %>

     <div class="max-w-2xl mx-auto px-4 pt-8">
          <div class="flex flex-col items-center text-center mb-6">
               <div class="avatar">
                    <div class="w-18 rounded-full ring ring-primary ring-offset-base-100 ring-offset-2">
                         <img src="/avatars/1.png" alt="الصورة الشخصية">
                    </div>
               </div>
               <p class="text-white text-lg font-bold mt-3"><%= userM.userName %></p>
          </div>

          <div class="card bg-blur border border-neutral-600 mb-6">
               <div class="card-body gap-3">
                    <div class="flex items-center gap-2">
                         <i class="fi fi-sr-envelope text-primary"></i>
                         <span class="text-white/80 text-sm"><%= userM.email %></span>
                    </div>
                    <div class="flex items-center gap-2">
                         <i class="fi fi-sr-key text-primary"></i>
                         <a href="/forgot-password" class="link link-primary no-underline text-sm">نسيت كلمة مروري</a>
                    </div>
                    <div class="flex items-center gap-2">
                         <i class="fi fi-sr-fingerprint text-primary"></i>
                         <span id="user-id" class="text-white/80 text-sm font-mono cursor-pointer" onclick="copyToClipboard()"><%= userM.userId %></span>
                         <button onclick="copyToClipboard()" class="btn btn-text btn-circle btn-xs" aria-label="نسخ المعرّف">
                              <i class="fi fi-sr-copy text-xs"></i>
                         </button>
                         <span id="copied-snackbar" class="text-xs text-success opacity-0 transition-opacity duration-300">تم النسخ</span>
                    </div>
               </div>
          </div>

          <div class="mb-4 flex items-center justify-between">
               <p class="text-white font-medium">دوراتي</p>
          </div>

          <% if (!courses || courses.length === 0) { %>
               <p class="text-center text-white/50 py-10">
                    لم تشترك في أي دورة بعد.
                    <a href="/courses" class="link link-primary no-underline">تصفّح الدورات</a>
               </p>
          <% } else { %>
               <div class="flex flex-col gap-3">
                    <% courses.forEach(course => { %>
                         <%
                              let firstVideoId = null;
                              if (course.chapters && course.chapters.length > 0 &&
                                  course.chapters[0].videos && course.chapters[0].videos.length > 0) {
                                   firstVideoId = course.chapters[0].videos[0]._id;
                              }
                              const watchLink = firstVideoId
                                   ? `/watch/${course._id}/${firstVideoId}`
                                   : `/watch/${course._id}`;
                         %>
                         <div class="card bg-blur border border-neutral-600">
                              <div class="card-body p-4 flex-row items-center justify-between">
                                   <p class="text-white text-sm font-medium"><%= course.title %></p>
                                   <a href="<%= watchLink %>" class="btn btn-primary btn-sm">
                                        مشاهدة
                                        <i class="fi fi-sr-play text-xs"></i>
                                   </a>
                              </div>
                         </div>
                    <% }) %>
               </div>
          <% } %>

          <div class="mt-8 text-center">
               <a href="/logout" class="btn btn-soft btn-error btn-sm">
                    تسجيل الخروج
                    <i class="fi fi-sr-sign-out-alt text-xs"></i>
               </a>
          </div>
     </div>

     <script src="/js/userManage.js"></script>
     <%- include("./partials/scripts.ejs") %>
</body>
</html>
