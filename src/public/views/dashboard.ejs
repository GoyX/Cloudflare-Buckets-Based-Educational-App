<!DOCTYPE html>
<html lang="ar" dir="rtl" data-theme="black">

<%- include("./partials/header.ejs", { pageTitle: 'لوحة التحكم' }) %>

<body class="min-h-screen bg-black pb-24 md:pb-10 md:pt-15">
     <%- include("./partials/loader.ejs") %>
     <%- include("./partials/navbar.ejs") %>

     <div class="max-w-2xl mx-auto px-4 pt-6">
          <h1 class="text-xl font-bold text-white mb-6">لوحة التحكم</h1>

          <div class="grid grid-cols-2 gap-3 mb-6">
               <a href="/admin/add-course" class="btn btn-primary">
                    إضافة دورة
                    <i class="fi fi-sr-plus text-sm"></i>
               </a>
               <a href="/admin/courses" class="btn btn-soft btn-primary">
                    إدارة الدورات
                    <i class="fi fi-sr-list text-sm"></i>
               </a>
          </div>

          <div class="border-t border-neutral-600 mb-6"></div>

          <div class="card bg-blur border border-neutral-600">
               <div class="card-body gap-4">
                    <p class="text-white font-medium">بحث عن مستخدم</p>
                    <form method="POST" action="/dashboard" class="flex gap-2">
                         <input type="number" name="userId" placeholder="123456" min="100000" max="999999" required
                                class="input flex-1">
                         <button type="submit" class="btn btn-primary">
                              بحث
                              <i class="fi fi-sr-search text-sm"></i>
                         </button>
                    </form>

                    <% if (typeof error !== 'undefined' && error) { %>
                         <div class="alert alert-soft alert-error text-sm"><%= error %></div>
                    <% } %>

                    <% if (typeof foundUser !== 'undefined' && foundUser) { %>
                         <div class="card bg-base-200/40 border border-neutral-600">
                              <div class="card-body p-4 gap-1">
                                   <p class="text-white font-medium"><%= foundUser.userName %></p>
                                   <p class="text-sm text-white/60"><%= foundUser.email %></p>
                                   <p class="text-sm text-white/40">المعرّف: <%= foundUser.userId %></p>
                                   <a href="/admin/manage/<%= foundUser.userId %>" class="btn btn-soft btn-primary btn-sm w-full mt-2">
                                        إدارة المستخدم
                                        <i class="fi fi-sr-arrow-left text-xs"></i>
                                   </a>
                              </div>
                         </div>
                    <% } %>
               </div>
          </div>
     </div>
</body>
</html>
