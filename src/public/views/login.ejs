<!DOCTYPE html>
<html lang="ar" dir="rtl" data-theme="black">

<%- include("./partials/header.ejs", { pageTitle: 'تسجيل الدخول' }) %>

<body class="min-h-screen bg-black">
     <%- include("./partials/navbar.ejs") %>

     <div class="min-h-screen flex items-center justify-center px-4 pb-24 pt-10 md:pt-24 md:pb-10">
          <div class="w-full max-w-md">
               <div class="card bg-blur border border-neutral-600 shadow-xl">
                    <div class="card-body gap-5">
                         <div class="text-center">
                              <h1 class="text-xl font-bold text-white">تسجيل الدخول</h1>
                              <div class="w-16 border-b radial-border mx-auto mt-3"></div>
                         </div>

                         <% if (typeof errors !== 'undefined' && errors) { %>
                              <div class="alert alert-soft alert-error text-sm" role="alert">
                                   <ul class="list-disc ps-4">
                                        <% errors.forEach(e => { %><li><%= e.msg %></li><% }) %>
                                   </ul>
                              </div>
                         <% } %>
                         <% if (typeof error !== 'undefined' && error) { %>
                              <div class="alert alert-soft alert-error text-sm" role="alert"><%= error %></div>
                         <% } %>
                         <% if (typeof note !== 'undefined' && note) { %>
                              <div class="alert alert-soft alert-success text-sm" role="alert"><%= note %></div>
                         <% } %>

                         <form method="POST" action="/login" class="flex flex-col gap-4">
                              <div class="input-floating">
                                   <input type="email" name="email" id="loginEmail" placeholder="user@example.com"
                                          value="<%= typeof req !== 'undefined' && req.body ? (req.body.email || '') : '' %>"
                                          class="input" required autocomplete="email">
                                   <label class="input-floating-label" for="loginEmail">البريد الإلكتروني</label>
                              </div>

                              <div class="input-floating">
                                   <input type="password" name="password" id="loginPassword" placeholder="••••••••"
                                          class="input" required autocomplete="current-password" minlength="8">
                                   <label class="input-floating-label" for="loginPassword">كلمة المرور</label>
                              </div>

                              <a href="/forgot-password" class="link link-primary text-sm no-underline self-start">نسيت كلمة المرور؟</a>

                              <button type="submit" class="btn btn-primary w-full mt-1">
                                   تسجيل الدخول
                                   <i class="fi fi-sr-sign-in-alt text-sm"></i>
                              </button>
                         </form>

                         <p class="text-center text-sm text-white/60">
                              ليس لديك حساب؟
                              <a href="/signup" class="link link-primary no-underline font-medium">إنشاء حساب</a>
                         </p>
                    </div>
               </div>
          </div>
     </div>
</body>
</html>
